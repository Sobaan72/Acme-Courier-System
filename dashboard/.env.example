# Supabase project (Settings -> API). The service role key stays on the server: never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Company this dashboard serves (companies.company_id)
COMPANY_ID=e9937002-053d-4f65-8274-b3c2d6eb8037
COMPANY_NAME=Acme Courier Co.

# Optional: HubSpot account id, for "Open in HubSpot" links
HUBSPOT_PORTAL_ID=

# Optional: lock the dashboard behind a browser password prompt. Leave empty for open access.
DASHBOARD_USER=
DASHBOARD_PASSWORD=
